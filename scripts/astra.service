[Unit]
Description=Astra Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ASTRA_PROJECT_ROOT__
EnvironmentFile=__ASTRA_PROJECT_ROOT__/.env
ExecStart=__ASTRA_PROJECT_ROOT__/.venv/bin/python -u -m app.main
Restart=on-failure
RestartSec=10
# Prevent infinite restart loops
StartLimitIntervalSec=300
StartLimitBurst=5
# Memory limits to prevent OOM kills (adjust based on your system)
# Increased due to large database (41GB) - needs cleanup but allowing more headroom for now
# Current usage: ~5.5GB peak observed, increasing limits to prevent OOM kills
# 2GB = 2097152K, 4GB = 4194304K, 6GB = 6291456K, 8GB = 8388608K
MemoryMax=8G
MemoryHigh=7G
# Note: OnOOMKill is not a valid systemd option - removed
# OOM kills will trigger Restart=on-failure behavior
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
