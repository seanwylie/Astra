# spawn_agents.example.config
# Copy to spawn_agents.config and customize for your Cursor project.
# The script sources this file; use valid bash syntax.

# Project name (for cycle message, display)
PROJECT_NAME="MyProject"

# One-line description for the plan prompt (e.g., tech stack, domain)
PROJECT_DESCRIPTION="a web app (React, Node.js, PostgreSQL)"

# Branch to require; exit if not on this branch. Empty = skip branch check.
REQUIRED_BRANCH="main"

# Plan prompt context: one bullet per line (script adds "- " prefix)
# Tell agents what to read and what constraints to follow.
PLAN_CONTEXT="Read docs/ and .cursor/rules/ if present
Follow architecture patterns (no lint:fix, no deployment, no risky scripts)
Plans will run headless: only include steps that use file edits or non-interactive commands (no npm install, no prompts)
Propose concrete, actionable improvements—not theoretical refactors"

# Extra constraints appended to execute prompt (project-specific rules)
# Leave empty if none.
EXTRA_EXEC_CONSTRAINTS="Do NOT run lint:fix. Do NOT deploy. Follow project architecture rules."

# Agents: "Display name|Goal phrase for prompt"
# Each agent plans improvements in its category; you approve y/n per plan.
AGENT_TOPICS=(
  "UX & Polish|as delightful, accessible, and error-resilient as we can"
  "Core Features|as complete and well-implemented as we can"
  "Performance|as fast and resource-efficient as we can"
  "Security|as secure and threat-resilient as we can"
)

# === Example: Astra-style (4 agents) ===
